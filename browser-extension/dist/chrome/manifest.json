{
  "manifest_version": 3,
  "name": "LocalMeetAssist",
  "version": "1.4.0",
  "description": "Запуск записи встреч через локальное приложение LocalMeetAssist.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "webNavigation", "storage", "notifications", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "LocalMeetAssist", "default_icon": {"16":"icons/16.png","32":"icons/32.png"} },
  "options_page": "options.html",
  "icons": { "16":"icons/16.png", "32":"icons/32.png", "48":"icons/48.png", "128":"icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" }
}
